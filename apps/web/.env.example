# Copy to .env.local and fill in. Never commit .env.local.

# --- LLM: Groq ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Model id. Must be a current, tool-calling-capable Groq model.
# Check https://console.groq.com/docs/models — ids are retired periodically.
EVE_MODEL=llama-3.3-70b-versatile

# Optional: override the Groq base URL (corporate proxy, or a local mock
# during testing). Leave unset to use api.groq.com.
# GROQ_BASE_URL=

# --- Quant engine ---
# The Python HTTP bridge that exposes the deterministic tools.
# Start it with: uv run python -m mcp.quant_server.http_bridge
QUANT_BRIDGE_URL=http://127.0.0.1:8010
