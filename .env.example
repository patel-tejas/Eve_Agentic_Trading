# --- DhanHQ (broker / market data) ---
# https://dhan.co → Console → API Access
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
# "API" for production, or "UAT" for testing
DHAN_ENV=PROD

# --- Upstox (broker / market data) ---
# https://upstox.com/developer → Analytics Access Token (read-only, ~1 year validity)
# Covers: market quote, historical candles (incl. expired contracts), websocket.
# NOT used for order placement (that needs the daily OAuth trading token, Phase 14).
UPSTOX_ANALYTICS_TOKEN=

# --- LLM (used from Phase 07, Eve agent) ---
LLM_API_KEY=

# --- Snowflake (Phase 09) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=

# --- MCP servers (Phase 07) ---
# Vercel: https://vercel.com/account/settings/tokens
VERCEL_TOKEN=
# Dhan MCP: same pair as DHAN_CLIENT_ID / DHAN_ACCESS_TOKEN above
# --- Eve web app (apps/web, Phase 49+) ---
# Model access: direct provider (Groq) — key lives in apps/web/.env.local
#   GROQ_API_KEY=gsk_...            # https://console.groq.com/keys
#   EVE_MODEL=llama-3.3-70b-versatile   # optional model override
# Alternative: Vercel AI Gateway (AI_GATEWAY_API_KEY at
# https://vercel.com/dashboard/ai/api-keys) or `eve link` for Vercel OIDC.
# Quant MCP server URL the eve agent connects to (start with:
#   uv run python -m mcp.quant_server.server --transport http --port 8010)
QUANT_MCP_URL=http://127.0.0.1:8010/mcp

# --- Telegram alerts (scripts/telegram_alerts.py) ---
# Create a bot with @BotFather, get the chat id of the target chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
