# --- DhanHQ (broker / market data) ---
# https://dhan.co → Console → API Access
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
# "API" for production, or "UAT" for testing
DHAN_ENV=PROD

# --- Upstox (broker / market data) ---
# https://upstox.com/developer → Analytics Access Token (read-only, ~1 year validity)
# Covers: market quote, historical candles (incl. expired contracts), websocket.
# NOT used for order placement (that needs the daily OAuth trading token, Phase 14).
UPSTOX_ANALYTICS_TOKEN=

# --- LLM (used from Phase 07, Eve agent) ---
LLM_API_KEY=

# --- Snowflake (Phase 09) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=

# --- MCP servers (Phase 07) ---
# Vercel: https://vercel.com/account/settings/tokens
VERCEL_TOKEN=
# Dhan MCP: same pair as DHAN_CLIENT_ID / DHAN_ACCESS_TOKEN above

# --- Common gate (Phase 15) ---
# Shared secret the Hisaab server sends as X-Eve-Internal. Required before
# binding the bridge to anything but 127.0.0.1. Generate: openssl rand -hex 32
EVE_INTERNAL_SECRET=
# Hisaab's Supabase project, used to verify users' access tokens (JWKS) and
# to store their strategies (algo_* tables, written AS the user so RLS holds).
SUPABASE_URL=
# Hisaab's publishable/anon key (NEXT_PUBLIC_SUPABASE_ANON_KEY).
SUPABASE_ANON_KEY=
# Optional: lets the engine write the tool audit log to algo_tool_audit.
# Server-side only; never used for a user's own data.
SUPABASE_SERVICE_ROLE_KEY=
# Only for projects still on the legacy HS256 JWT secret (no JWKS keys).
SUPABASE_JWT_SECRET=
# 1 = every tool, research ones included, needs a signed-in user.
EVE_REQUIRE_USER=
# Local research console only: act as this user id without a token.
EVE_LOCAL_DEV=
EVE_LOCAL_USER_ID=
# Local-dev strategy store (SQLite), default data/local/strategies.sqlite.
EVE_LOCAL_STORE_PATH=
# 1 = block paper-trading state changes for everyone.
EVE_KILL_SWITCH=
# Audit JSONL path (default data/audit/tool_audit.jsonl); "off" disables.
EVE_AUDIT_PATH=
